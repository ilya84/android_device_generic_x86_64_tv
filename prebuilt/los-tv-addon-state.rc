# los-tv: state of the "proprietary components" tile.
#
# NOTE: this init build does not register service blocks from
# /system/etc/init (see addon-autorestore.rc).  Use exec actions with an
# explicit seclabel; without it exec stays in u:r:init:s0 and cannot start
# /system/bin/sh (shell_exec).
on property:sys.boot_completed=1
    exec u:r:su:s0 root root -- /system/bin/sh /system/bin/los-tv-addon-check.sh

on property:sys.los_tv.addon_needed=1
    exec u:r:su:s0 shell shell -- /system/bin/sh /system/bin/los-tv-addon-notify.sh
