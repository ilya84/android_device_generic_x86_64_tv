# Play Store: выдать appop ACTIVATE_VPN при каждой загрузке (apply-step27.py).
# Без него DownloadService (FGS типа systemExempted) падает, и установка
# приложений из магазина зависает на «Подождите…» — подробности в скрипте.
#
# exec вместо service: init этой сборки не регистрирует on-property из
# service-файла; seclabel обязателен для запуска /system/bin/sh под Enforcing.
on property:sys.boot_completed=1
    exec u:r:su:s0 root root -- /system/bin/sh /system/bin/play-store-fixups.sh
