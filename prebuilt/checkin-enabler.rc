# Включение check-in microG при первой загрузке (apply-step24.py).
# Один раз: пока нет /data/misc/checkin-enabler.done. Под root —
# content требует root (signature-permission WRITE_SETTINGS).
#
# exec вместо service: init этой сборки не регистрирует on-property из
# service-файла; seclabel обязателен для запуска /system/bin/sh под Enforcing.
on property:sys.boot_completed=1
    exec u:r:su:s0 root root -- /system/bin/sh /system/bin/checkin-enabler.sh
