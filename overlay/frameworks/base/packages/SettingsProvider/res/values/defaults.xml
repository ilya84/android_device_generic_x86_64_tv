<resources>
    <!-- los-tv: Bluetooth must be on by default so Android TV settings expose
         "Add accessory" and a Bluetooth remote can be paired on first boot. -->
    <bool name="def_bluetooth_on">true</bool>
    <bool name="def_lockscreen_disabled">false</bool>
    <integer name="def_screen_off_timeout">600000000</integer>
    <integer name="def_sleep_timeout">86400000</integer>    
    <bool name="def_accelerometer_rotation">true</bool>
    <!-- default setting for Settings.System.POWERMENU_ADVANCED -->
    <bool name="def_powermenu_advanced">false</bool>
    <!-- los-tv: a TV must be allowed to turn the screen off, otherwise the
         screensaver (Dream) never starts. Users can still enable "Stay awake"
         in developer options. -->
    <bool name="def_stay_on_while_plugged_in">false</bool>
</resources>
